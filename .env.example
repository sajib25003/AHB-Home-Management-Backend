NODE_ENV=development
PORT=4000
DATABASE_URL=mongodb://127.0.0.1:27017/ahb-home-management

# Use different, cryptographically random values. Production requires 32+ chars.
JWT_SECRET=replace-with-a-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret
JWT_ISSUER=ahb-home-management-api
JWT_AUDIENCE=ahb-home-management-web

# Comma-separated when more than one exact frontend origin is required.
CLIENT_URLS=http://localhost:3000
COOKIE_SAME_SITE=lax
# Usually 1 behind a single production reverse proxy; verify with your host.
TRUST_PROXY_HOPS=0

SUPER_ADMIN_FIRST_NAME=Ashik
SUPER_ADMIN_LAST_NAME=Bhuiyan
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PHONE=01000000000
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
